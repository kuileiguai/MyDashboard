# 复制为 backend/.env（或项目根目录 .env）后按需修改。
# 真实环境变量优先级更高，.env 只作为缺省值。
# 修改后需重启后端生效。

# ── 服务器 ──
DASH_HOST=127.0.0.1
DASH_PORT=8787

# ── 数据 / 日志目录 ──
# DASH_DATA_DIR=/mnt/项目数据/MyDashboard/data
# DASH_LOG_DIR=

# ── 采样 ──
# DASH_MONITOR_INTERVAL=2.0
# DASH_MONITOR_IDLE_INTERVAL=10.0
# DASH_MONITOR_HISTORY_POINTS=150

# ── PTY ──
# DASH_PTY_SCROLLBACK_LINES=5000
# DASH_PTY_MAX_SESSIONS=20

# ── 安全 ──
# 允许访问的根目录，逗号分隔；默认 / 表示不限制
# DASH_ALLOWED_ROOTS=/
# DASH_DISK_ALERT_THRESHOLD=0.90

# ── 远程访问认证 ──
DASH_AUTH_USER=admin
# 局域网 / 远程访问必填（留空则非本机访问一律拒绝）
# DASH_AUTH_PASSWORD=换成你的强密码
# 不想写明文可填 sha256：echo -n '密码' | sha256sum | awk '{print $1}'
# DASH_AUTH_PASSWORD_HASH=
# DASH_AUTH_SESSION_TTL=43200
# 本机来源免登录，部署到共享环境建议置 0
# DASH_AUTH_LOCAL_BYPASS=1
# DASH_AUTH_MAX_FAILS=5
# DASH_AUTH_LOCK_SECONDS=300

# 挂了可信反向代理才置 1（开启后伪造 X-Forwarded-For 即可冒充本机）
# DASH_TRUST_PROXY=0

# ── shell 历史同步 ──
# DASH_HISTORY_SYNC_INTERVAL=5.0
# DASH_HISTORY_GLOBAL=0
# DASH_HISTORY_MAX_ENTRIES=200

# ── AI 对话 ──
# 关闭后 /api/ai/* 返回禁用状态，前端隐藏 AI 入口
# DASH_AI_ENABLED=1
# OpenAI-compatible：Ollama / vLLM / LM Studio / DeepSeek / OpenAI 都可以
# DASH_AI_PROVIDER=openai-compatible
# DASH_AI_BASE_URL=http://127.0.0.1:11434/v1
# DASH_AI_MODEL=qwen2.5:14b
# 本地模型可留空；云端模型填 API Key（也可在页面设置里填，页面保存后会加密存库）
# DASH_AI_API_KEY=
# DASH_AI_TIMEOUT=120
# DASH_AI_MAX_TOKENS=4096
# DASH_AI_CONTEXT_BUDGET=32000
# 0=只允许本机/内网模型地址；1=允许公网地址（配置/命令会发送到外部）
# DASH_AI_ALLOW_CLOUD=0
# confirm_all / confirm_stop / auto_start
# DASH_AI_ACTION_MODE=confirm_all
